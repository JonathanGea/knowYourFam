{
  "name": "knowyourfam-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "ng build",
    "check": "ng build --configuration development",
    "test": "npm run check",
    "test:canvas": "node --experimental-strip-types --test scripts/*.test.mjs",
    "dev": "ng serve --host 0.0.0.0",
    "test:serve": "node scripts/server-smoke.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "typescript": ">=6.0.0 <6.1.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
